# Tour de Cloud containers resolve each other by service name.
# Local compose uses host networking. Reverse proxy only — TdC terminates TLS.
{
    servers {
        # Keep TdC's X-Forwarded-Proto: https instead of overwriting it with http;
        # SvelteKit's form-action CSRF check needs the real https origin.
        trusted_proxies static private_ranges
    }
}

:80 {
    handle /api/* {
        reverse_proxy server:3001
    }
    reverse_proxy * web:3000
}
